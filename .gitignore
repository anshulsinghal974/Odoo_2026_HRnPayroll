# Root .gitignore for PeoplePay360

# Node & Package Managers
node_modules/
*/node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
*/dist/
build/
*/build/

# Environment files
.env
.env.*
!.env.example

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python & ML Service
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
