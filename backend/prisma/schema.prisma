generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum Role {
  EMPLOYEE
  HR_MANAGER
  HR_PAYROLL_USER
  HR_PAYROLL_MANAGER
  ADMIN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimeOffUnit {
  DAYS
  HOURS
}

enum ApprovalMode {
  NO_APPROVAL
  HR_APPROVAL
  MANAGER_APPROVAL
  BOTH
}

enum AllocationStatus {
  DRAFT
  APPROVED
  REFUSED
}

enum LeaveStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REFUSED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  PARTIAL
}

enum RuleCategory {
  BASIC
  ALLOWANCE
  GROSS
  DEDUCTION
  NET
}

enum ComputationType {
  FIXED
  PERCENTAGE
  FORMULA
}

enum PayrunStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
}

enum PayslipStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
}

// ──────────────────────────────────────────────
// USER & AUTH
// ──────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(EMPLOYEE)
  employeeId   String?   @unique @map("employee_id")
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

// ──────────────────────────────────────────────
// EMPLOYEE
// ──────────────────────────────────────────────

model Employee {
  id             String         @id @default(uuid())
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  email          String         @unique
  phone          String?
  department     String?
  jobPosition    String?        @map("job_position")
  status         EmployeeStatus @default(ACTIVE)

  // Self-referencing manager relationship
  managerId      String?        @map("manager_id")
  manager        Employee?      @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates   Employee[]     @relation("ManagerSubordinates")

  // Working schedule assignment
  scheduleId     String?        @map("schedule_id")
  schedule       WorkingSchedule? @relation(fields: [scheduleId], references: [id])

  // Bank details (stored as JSON for flexibility)
  bankName       String?        @map("bank_name")
  bankAccount    String?        @map("bank_account")
  bankIFSC       String?        @map("bank_ifsc")

  // Profile
  dateOfBirth    DateTime?      @map("date_of_birth")
  gender         String?
  address        String?
  emergencyContact String?      @map("emergency_contact")
  profileImage   String?        @map("profile_image")

  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Relations
  user           User?
  contracts      Contract[]
  attendances    Attendance[]
  allocations    Allocation[]
  leaveRequests  LeaveRequest[] @relation("EmployeeLeaves")
  approvedLeaves LeaveRequest[] @relation("ApproverLeaves")
  payslips       Payslip[]

  @@map("employees")
}

// ──────────────────────────────────────────────
// CONTRACT
// ──────────────────────────────────────────────

// CONSTRAINT: Only one ACTIVE contract per employee at any given time.
// Enforced at the application level in the contract service/middleware:
//   Before setting a contract to ACTIVE, the service must check that no other
//   contract for the same employee_id already has status = ACTIVE.
//   A PostgreSQL partial unique index can also be added via raw SQL migration:
//     CREATE UNIQUE INDEX idx_one_active_contract_per_employee
//     ON contracts (employee_id) WHERE status = 'ACTIVE';

model Contract {
  id                 String          @id @default(uuid())
  employeeId         String          @map("employee_id")
  employee           Employee        @relation(fields: [employeeId], references: [id])
  name               String
  startDate          DateTime        @map("start_date")
  endDate            DateTime?       @map("end_date")
  wage               Decimal         @db.Decimal(12, 2)
  department         String?
  jobPosition        String?         @map("job_position")
  status             ContractStatus  @default(DRAFT)

  // Salary structure used for payroll computation
  salaryStructureId  String?         @map("salary_structure_id")
  salaryStructure    SalaryStructure? @relation(fields: [salaryStructureId], references: [id])

  // Working schedule override (if different from employee-level)
  scheduleId         String?         @map("schedule_id")
  schedule           WorkingSchedule? @relation(fields: [scheduleId], references: [id])

  notes              String?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  // Relations
  payslips           Payslip[]

  @@map("contracts")
}

// ──────────────────────────────────────────────
// WORKING SCHEDULE
// ──────────────────────────────────────────────

model WorkingSchedule {
  id          String         @id @default(uuid())
  name        String
  type        String         @default("standard") // e.g. standard, flexible, shift
  totalHours  Decimal?       @map("total_hours") @db.Decimal(5, 2) // auto-calculated
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relations
  lines       ScheduleLine[]
  employees   Employee[]
  contracts   Contract[]

  @@map("working_schedules")
}

model ScheduleLine {
  id          String          @id @default(uuid())
  scheduleId  String          @map("schedule_id")
  schedule    WorkingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  day         DayOfWeek
  startTime   String          @map("start_time") // HH:mm format
  endTime     String          @map("end_time")   // HH:mm format
  breakMins   Int             @default(0) @map("break_mins")

  @@map("schedule_lines")
}

// ──────────────────────────────────────────────
// TIME OFF
// ──────────────────────────────────────────────

model TimeOffType {
  id                  String        @id @default(uuid())
  name                String        @unique
  unit                TimeOffUnit   @default(DAYS)
  requiresAllocation  Boolean       @default(true) @map("requires_allocation")
  approvalMode        ApprovalMode  @default(HR_APPROVAL) @map("approval_mode")
  carryOver           Boolean       @default(false) @map("carry_over")
  color               String?       // for UI display
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  // Relations
  allocations         Allocation[]
  leaveRequests       LeaveRequest[]

  @@map("time_off_types")
}

model Allocation {
  id             String           @id @default(uuid())
  employeeId     String           @map("employee_id")
  employee       Employee         @relation(fields: [employeeId], references: [id])
  typeId         String           @map("type_id")
  type           TimeOffType      @relation(fields: [typeId], references: [id])
  numberOfDays   Decimal          @map("number_of_days") @db.Decimal(5, 2)
  dateFrom       DateTime         @map("date_from")
  dateTo         DateTime         @map("date_to")
  status         AllocationStatus @default(DRAFT)
  taken          Decimal          @default(0) @map("taken") @db.Decimal(5, 2)
  remaining      Decimal          @default(0) @db.Decimal(5, 2) // computed: numberOfDays - taken
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relations
  leaveRequests  LeaveRequest[]

  @@map("allocations")
}

model LeaveRequest {
  id             String      @id @default(uuid())
  employeeId     String      @map("employee_id")
  employee       Employee    @relation("EmployeeLeaves", fields: [employeeId], references: [id])
  typeId         String      @map("type_id")
  type           TimeOffType @relation(fields: [typeId], references: [id])
  allocationId   String?     @map("allocation_id")
  allocation     Allocation? @relation(fields: [allocationId], references: [id])
  dateFrom       DateTime    @map("date_from")
  dateTo         DateTime    @map("date_to")
  duration       Decimal     @db.Decimal(5, 2) // in days or hours depending on type
  status         LeaveStatus @default(DRAFT)
  reason         String?
  approverId     String?     @map("approver_id")
  approver       Employee?   @relation("ApproverLeaves", fields: [approverId], references: [id])
  approvedAt     DateTime?   @map("approved_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@map("leave_requests")
}

// ──────────────────────────────────────────────
// ATTENDANCE
// ──────────────────────────────────────────────

model Attendance {
  id               String           @id @default(uuid())
  employeeId       String           @map("employee_id")
  employee         Employee         @relation(fields: [employeeId], references: [id])
  checkIn          DateTime         @map("check_in")
  checkOut         DateTime?        @map("check_out")
  workedHours      Decimal?         @map("worked_hours") @db.Decimal(5, 2)
  status           AttendanceStatus @default(PRESENT)

  // Correction audit trail
  isCorrected      Boolean          @default(false) @map("is_corrected")
  originalCheckIn  DateTime?        @map("original_check_in")
  originalCheckOut DateTime?        @map("original_check_out")
  correctedBy      String?          @map("corrected_by") // user ID who made correction
  correctionNote   String?          @map("correction_note")

  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@map("attendances")
}

// ──────────────────────────────────────────────
// SALARY STRUCTURE & RULES
// ──────────────────────────────────────────────

model SalaryStructure {
  id        String       @id @default(uuid())
  name      String       @unique
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // Relations
  rules     SalaryRule[]
  contracts Contract[]
  payruns   Payrun[]

  @@map("salary_structures")
}

// Salary rules execute in ascending `sequence` order within a structure.
// Category determines the computation phase:
//   BASIC → ALLOWANCE → GROSS → DEDUCTION → NET
// ComputationType:
//   FIXED       – uses `amount` directly
//   PERCENTAGE  – amount = (percentageBaseCode's result) * (percentage / 100)
//   FORMULA     – evaluated at runtime referencing prior rule codes
model SalaryRule {
  id                  String          @id @default(uuid())
  structureId         String          @map("structure_id")
  structure           SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  name                String
  code                String          // e.g. BASIC, HRA, GROSS, PF, NET
  category            RuleCategory
  sequence            Int             // execution order
  computation         ComputationType @default(FIXED)
  amount              Decimal?        @db.Decimal(12, 2)          // for FIXED
  percentage          Decimal?        @db.Decimal(5, 2)           // for PERCENTAGE
  percentageBaseCode  String?         @map("percentage_base_code") // code of rule to base % on
  formula             String?         // for FORMULA computation
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  // Relations
  payslipLines        PayslipLine[]

  // Each code must be unique within a structure
  @@unique([structureId, code])
  @@map("salary_rules")
}

// ──────────────────────────────────────────────
// PAYRUN & PAYSLIP
// ──────────────────────────────────────────────

model Payrun {
  id              String          @id @default(uuid())
  name            String
  structureId     String          @map("structure_id")
  structure       SalaryStructure @relation(fields: [structureId], references: [id])
  periodStart     DateTime        @map("period_start")
  periodEnd       DateTime        @map("period_end")
  status          PayrunStatus    @default(DRAFT)
  createdBy       String?         @map("created_by") // user ID
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relations
  payslips        Payslip[]

  @@map("payruns")
}

model Payslip {
  id           String        @id @default(uuid())
  payrunId     String        @map("payrun_id")
  payrun       Payrun        @relation(fields: [payrunId], references: [id])
  employeeId   String        @map("employee_id")
  employee     Employee      @relation(fields: [employeeId], references: [id])
  contractId   String?       @map("contract_id")
  contract     Contract?     @relation(fields: [contractId], references: [id])
  status       PayslipStatus @default(DRAFT)
  workedDays   Decimal?      @map("worked_days") @db.Decimal(5, 2)
  netAmount    Decimal?      @map("net_amount") @db.Decimal(12, 2)
  pdfUrl       String?       @map("pdf_url")
  emailSentAt  DateTime?     @map("email_sent_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relations
  lines        PayslipLine[]

  @@unique([payrunId, employeeId]) // no duplicate payslips per employee per payrun
  @@map("payslips")
}

model PayslipLine {
  id          String     @id @default(uuid())
  payslipId   String     @map("payslip_id")
  payslip     Payslip    @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  ruleId      String     @map("rule_id")
  rule        SalaryRule @relation(fields: [ruleId], references: [id])
  ruleName    String     @map("rule_name")
  category    RuleCategory
  sequence    Int
  amount      Decimal    @db.Decimal(12, 2)
  createdAt   DateTime   @default(now()) @map("created_at")

  @@map("payslip_lines")
}
